# Copy to .env and fill in your keys.

# Required — OpenAI (script writing + TTS voices)
OPENAI_API_KEY=sk-...
SCRIPT_MODEL=gpt-4o-mini
TTS_MODEL=gpt-4o-mini-tts

# Recommended — Deepgram (word-synced captions + intelligence)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Optional — Upload-Post (auto-publish to social)
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=          # your upload-post profile handle; blank = uploads disabled
TIMEZONE=America/Los_Angeles

# News sources to aggregate (comma-separated): gdelt, googlenews, outlets
NEWS_SOURCES=gdelt,googlenews,outlets

# Server port
PORT=5174
