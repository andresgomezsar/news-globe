# Copy to .env and fill in your keys.

# Required — OpenAI (script writing + TTS voices)
OPENAI_API_KEY=sk-...
SCRIPT_MODEL=gpt-4o-mini
TTS_MODEL=gpt-4o-mini-tts

# Recommended — Deepgram (word-synced captions + intelligence)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Optional — Upload-Post (auto-publish to social)
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=          # your upload-post profile handle; blank = uploads disabled
TIMEZONE=America/Los_Angeles

# News sources to aggregate (comma-separated): gdelt, googlenews, outlets
NEWS_SOURCES=gdelt,googlenews,outlets

# Server port
PORT=5174

# Generate a unique random token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Paste it here, then use it on the News Globe sign-in screen. Never commit .env.
NEWS_GLOBE_TOKEN=
HOST=127.0.0.1
ENABLE_PUBLISHING=false
# For an HTTPS deployment, also set COOKIE_SECURE=true and its exact UI origin:
# ALLOWED_ORIGINS=https://news.example.com
COOKIE_SECURE=false
